# Cloudflare credentials used by scripts/deploy.sh (and wrangler).
# CLOUDFLARE_API_TOKEN is optional: if empty, wrangler falls back to the
# OAuth login stored by `npx wrangler login`. A token is more reliable for
# unattended deploys — create one from the "Edit Cloudflare Workers" template
# at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
